{
    "$schema": "https://biomejs.dev/schemas/2.3.2/schema.json",
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noRedeclare": "off",
                "noExplicitAny": "warn"
            },
            "complexity": {
                "noThisInStatic": "off",
                "useLiteralKeys": "off"
            }
        },
        "includes": [
            "src/**",
            "!**/node_modules",
            "!**/dist",
            "!**/coverage",
            "!**/*.test.ts",
            "!**/*.test.tsx",
            "!**/*.spec.ts",
            "!**/*.stories.ts",
            "!**/*.stories.tsx"
        ]
    },
    "formatter": {
        "enabled": false
    }
}
