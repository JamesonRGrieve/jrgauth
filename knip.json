{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/index.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}",
    "src/app/**/page.{ts,tsx}",
    "src/app/**/layout.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignore": ["dist/**", "node_modules/**", "**/*.d.ts"],
  "ignoreDependencies": [
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "@tailwindcss/postcss",
    "tailwindcss-animate",
    "@jgrieve/dynamic-form",
    "zod2gql"
  ],
  "ignoreBinaries": [
    "gh-pages"
  ]
}
