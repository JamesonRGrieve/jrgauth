{
  "semi": true,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "trailingComma": "all",
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "consistent",
  "endOfLine": "lf",
  "printWidth": 125,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "singleAttributePerLine": false
}
